# Copy privately to .env and supply CURRENT values before any deployment.
# Empty values intentionally fail Compose validation; these are not credentials.
# Do not commit .env, print resolved configuration, or use shell tracing.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Privately provision a non-root, warehouse-scoped S3 identity for this template.
# The template shares this pair across REST, Trino and the optional host resource.
# Existing deployments need a coordinated migration; never reuse the root pair.
LAKEHOUSE_S3_ACCESS_KEY_ID=
LAKEHOUSE_S3_SECRET_ACCESS_KEY=
# Compose reads .env for interpolation. Host Dagster needs explicit environment
# injection from a private launcher/secret manager; Compose does not export it.
